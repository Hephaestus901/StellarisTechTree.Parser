<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Tech\TechTest.fs" />
        <Compile Include="Tech\Tests.fs" />
        <Compile Include="Locale\LocaleTest.fs" />
        <Compile Include="Locale\Tests.fs" />
        <Compile Include="Variable\VariableTest.fs" />
        <Compile Include="Variable\Tests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\StellarisTechTree.Functional\StellarisTechTree.Functional.fsproj" />
    </ItemGroup>

</Project>
